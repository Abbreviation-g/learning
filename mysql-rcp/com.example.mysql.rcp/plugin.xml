<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension id="application" point="org.eclipse.core.runtime.applications">
        <application>
            <run class="com.example.mysql.rcp.Application"/>
        </application>
    </extension>
    <extension id="product" point="org.eclipse.core.runtime.products">
        <product application="com.example.mysql.rcp.application" name="MySQL RCP Client">
            <property name="appName" value="MySQL RCP Client"/>
        </product>
    </extension>
    <extension point="org.eclipse.ui.perspectives">
        <perspective
            id="com.example.mysql.rcp.perspective"
            name="MySQL"
            class="com.example.mysql.rcp.ui.Perspective"/>
    </extension>
    <extension point="org.eclipse.ui.views">
        <view
            id="com.example.mysql.rcp.ui.mysqlConnectionView"
            name="MySQL Connection"
            class="com.example.mysql.rcp.ui.MySqlConnectionView"/>
    </extension>
</plugin>
